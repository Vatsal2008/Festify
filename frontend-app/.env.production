# Base URL the frontend calls in production builds.
# Not a secret: Vite inlines VITE_* vars into the client bundle, so this
# is public either way. Committed so deploys work without manual config;
# override it in the Vercel dashboard if the backend URL changes.
VITE_API_BASE_URL=https://festify-9z0h.onrender.com
VITE_GOOGLE_CLIENT_ID=688106591634-iqkp16v5v36bhtn2kve08f9kl8lnccu2.apps.googleusercontent.com

# Restrict checkout to UPI only. Keep false until UPI is enabled on the
# Razorpay account -- verify with GET /v1/methods?key_id=<key>. Enforcing
# it while UPI is off leaves Checkout with no usable method and it fails
# with "no appropriate payment method found".
VITE_PAYMENT_UPI_ONLY=false

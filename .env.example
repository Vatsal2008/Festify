# Auth
GOOGLE_CLIENT_ID=
# Comma-separated bootstrap super admins. Works even when the
# super_admins table is empty, so a fresh deploy always has a way in.
SUPER_ADMIN_EMAILS=
JWT_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase (FCM) - path to the downloaded service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Email ─────────────────────────────────────────────────────────
# The backend picks the first transport that has credentials, in this
# order: self-hosted relay, Resend, Brevo, SMTP.
#
# Render's free instances block outbound traffic to every SMTP port
# (25, 465, 587) as of September 2025, so SMTP works locally but never
# in production there. Port 443 is open, which is what the other three
# use. GET /health/config reports which one is active.

# SMTP - works locally; blocked on Render free instances.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_MAIL=
SMTP_PASSWORD=

# Self-hosted relay: a mail API on a developer machine, published over
# an HTTPS tunnel. Only works while that machine and tunnel are up.
LOCAL_API_KEY=
LOCAL_MAIL_URL=

# Hosted email over HTTPS. Either one works on Render.
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Festify

# ── Frontend (frontend/.env) ──────────────────────────────────────
# VITE_API_BASE_URL=https://your-backend.onrender.com
# VITE_GOOGLE_CLIENT_ID=
# VITE_PAYMENT_UPI_ONLY=false
